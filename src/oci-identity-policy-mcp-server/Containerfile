FROM ghcr.io/oracle/oraclelinux:9-slim@sha256:1950389c3dd619841813520b4e69d7f3112c4c10f713fcb90680703d184c33ad

# Install python 3.13
RUN microdnf install epel-release && \
  microdnf install python3.13 python3.13-pip \
  && rm -rf /var/cache/dnf/* \
  && useradd -m -d /app oracle

WORKDIR /app

# Package selection for no-code integration.
# Override at build time to consume your own published pip package.
ARG OPA_PIP_PACKAGE=oci-policy-analysis
ARG OPA_PIP_VERSION=
ARG OPA_PIP_EXTRAS=mcp

RUN if [ -n "$OPA_PIP_VERSION" ]; then \
      if [ -n "$OPA_PIP_EXTRAS" ]; then \
        pip3.13 install --no-cache-dir "${OPA_PIP_PACKAGE}[${OPA_PIP_EXTRAS}]==${OPA_PIP_VERSION}"; \
      else \
        pip3.13 install --no-cache-dir "${OPA_PIP_PACKAGE}==${OPA_PIP_VERSION}"; \
      fi; \
    else \
      if [ -n "$OPA_PIP_EXTRAS" ]; then \
        pip3.13 install --no-cache-dir "${OPA_PIP_PACKAGE}[${OPA_PIP_EXTRAS}]"; \
      else \
        pip3.13 install --no-cache-dir "${OPA_PIP_PACKAGE}"; \
      fi; \
    fi

COPY docker-entrypoint.sh /usr/local/bin/oci-identity-policy-mcp-entrypoint

RUN mkdir -p /app/.oci-policy-analysis/cache /app/.oci-policy-analysis/logs \
  && chown -R oracle:oracle /app/.oci-policy-analysis \
  && chmod 0755 /usr/local/bin/oci-identity-policy-mcp-entrypoint

USER oracle

# Runtime defaults for containerized MCP HTTP mode
ENV MCP_AUTH_MODE="resource_principal"
ENV MCP_TRANSPORT="streamable-http"
ENV MCP_HOST="0.0.0.0"
ENV MCP_PORT="8765"
ENV MCP_LOG_LEVEL="INFO"
ENV MCP_SAVE_CACHE_AFTER_LOAD="true"
ENV MCP_COMPARTMENT_DOMAIN_SEARCH_DEPTH="2"

ENTRYPOINT ["/usr/local/bin/oci-identity-policy-mcp-entrypoint"]
